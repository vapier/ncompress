#!/bin/sh

OPTIONS=
while case ${1-} in -*) true;; *) false;; esac
do
	case $1 in
	--)	shift; break;;
	esac
	OPTIONS="$OPTIONS $1"
	shift
done

case $# in
1)	FILE=${1%.Z}
	zcat -- "$FILE" | diff $OPTIONS -- - "$FILE"
	STAT=$?;;
2)	case $1 in
	*.Z)	case $2 in
		*.Z)	tmp=
			trap 'test -n "$tmp" && rm -f "$tmp"; exit 2' HUP INT PIPE TERM
			trap 'test -n "$tmp" && rm -f "$tmp"' 0
			if type mktemp >/dev/null 2>&1; then
				tmp=`mktemp "${TMPDIR:-/tmp}/zdiff.XXXXXX"` || exit 2
			else
				set -C
				tmp=${TMPDIR:-/tmp}/zdiff.$$
				(umask 077; : >"$tmp") 2>/dev/null || exit 2
			fi
			zcat -- "$2" >"$tmp" || exit 2
			zcat -- "$1" | diff $OPTIONS -- - "$tmp"
			STAT=$?
			rm -f "$tmp"
			trap - HUP INT PIPE TERM 0;;
		*)	zcat -- "$1" | diff $OPTIONS -- - "$2"
			STAT=$?;;
		esac;;
	*)	case $2 in
		*.Z)	zcat -- "$2" | diff $OPTIONS -- "$1" -
			STAT=$?;;
		*)	diff $OPTIONS -- "$1" "$2"
			STAT=$?;;
		esac;;
	esac;;
*)	echo "Usage: zdiff [diff_options] file [file]" >&2
	exit 1;;
esac
exit "$STAT"
